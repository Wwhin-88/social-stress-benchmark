#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
# ssb launcher — auto-activates .venv and runs the Social Stress Benchmark.
#
# Usage:  ./ssb              → TUI
#         ./ssb run          → CLI benchmark
#         ./ssb repl         → legacy REPL
#
# First run: creates .venv + installs dependencies automatically.
# ═══════════════════════════════════════════════════════════════════════════
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_DIR="$SCRIPT_DIR/.venv"

# ── Bootstrap: create venv + install if missing ──────────────────────────
if [[ ! -d "$VENV_DIR" ]]; then
    echo "⚙  Setting up virtual environment..."
    python3 -m venv "$VENV_DIR"
    "$VENV_DIR/bin/pip" install -q -e "$SCRIPT_DIR"
    echo "✓ Ready."
fi

# ── Reinstall if pyproject.toml changed (detect new deps) ────────────────
PYPROJECT="$SCRIPT_DIR/pyproject.toml"
STAMP="$VENV_DIR/.install_stamp"
if [[ "$PYPROJECT" -nt "$STAMP" ]]; then
    "$VENV_DIR/bin/pip" install -q -e "$SCRIPT_DIR"
    touch "$STAMP"
fi

# ── Launch ───────────────────────────────────────────────────────────────
exec "$VENV_DIR/bin/ssb" "$@"
