/*
 * Global Textual CSS styles for the Social Stress Benchmark TUI.
 *
 * Theme: dark background with bright_blue/cyan accents (matching existing Rich theme).
 */

/* ================================================================== */
/* Base                                                               */
/* ================================================================== */

Screen {
    background: #0d1117;
    color: #c9d1d9;
}

/* ================================================================== */
/* Header / Footer                                                    */
/* ================================================================== */

Header {
    background: #161b22;
    color: #58a6ff;
    text-style: bold;
    dock: top;
    height: 3;
}

Footer {
    background: #161b22;
    color: #8b949e;
    dock: bottom;
    height: 1;
}

Footer > .footer--key {
    color: #58a6ff;
    text-style: bold;
}

Footer > .footer--highlight {
    background: #1f6feb;
    color: #ffffff;
}

/* ================================================================== */
/* Welcome Screen                                                     */
/* ================================================================== */

#welcome-screen {
    align: center middle;
}

#welcome-box {
    width: 60;
    height: auto;
    border: solid #58a6ff;
    padding: 1 2;
    background: #161b22;
}

#welcome-box .title {
    text-style: bold;
    color: #58a6ff;
    content-align: center middle;
    padding: 1;
}

#welcome-box .subtitle {
    color: #8b949e;
    content-align: center middle;
    padding-bottom: 1;
}

#welcome-box .step-label {
    color: #58a6ff;
    text-style: bold;
}

#welcome-box Input {
    margin: 1 0;
    border: solid #30363d;
}

#welcome-box Input:focus {
    border: solid #58a6ff;
}

/* ================================================================== */
/* Main Menu Screen                                                   */
/* ================================================================== */

#main-menu {
    align: center middle;
}

#menu-box {
    width: 50;
    border: solid #58a6ff;
    padding: 1 2;
    background: #161b22;
}

#menu-box .menu-title {
    text-style: bold;
    color: #58a6ff;
    content-align: center middle;
    padding: 1;
}

#menu-box .menu-item {
    padding: 0 2;
    height: 3;
}

#menu-box .menu-item.highlighted {
    background: #1f6feb;
    color: #ffffff;
}

#menu-box .menu-key {
    color: #58a6ff;
    text-style: bold;
}

/* ================================================================== */
/* Run Config Screen                                                  */
/* ================================================================== */

#run-config {
    layout: grid;
    grid-size: 3 1;
    grid-columns: 3fr 1fr;
    grid-gutter: 1 2;
    padding: 1 2;
}

#selector-area {
    column-span: 2;
}

#sidebar {
    layout: vertical;
}

#sidebar .sidebar-title {
    text-style: bold;
    color: #58a6ff;
    padding: 0 1;
}

#sidebar .status-bar {
    height: auto;
    padding: 0 1;
    margin-top: 1;
    border: solid #30363d;
}

#start-button {
    width: 100%;
    margin-top: 1;
}

#start-button:hover {
    background: #238636;
}

/* ================================================================== */
/* Run Progress Screen                                                */
/* ================================================================== */

#run-progress {
    padding: 1 2;
}

#progress-header {
    text-style: bold;
    color: #58a6ff;
    padding-bottom: 1;
}

#progress-log {
    height: 1fr;
    border: solid #30363d;
    margin-top: 1;
    padding: 0 1;
    background: #0d1117;
}

/* ================================================================== */
/* Results Screen                                                     */
/* ================================================================== */

#results-screen {
    padding: 1 2;
}

#results-header {
    text-style: bold;
    color: #58a6ff;
}

#results-table {
    margin-top: 1;
    height: 1fr;
}

#results-summary {
    margin-top: 1;
    padding: 1 2;
    border: solid #30363d;
    background: #161b22;
}

/* ================================================================== */
/* Shared / Utilities                                                 */
/* ================================================================== */

.success {
    color: #3fb950;
}

.error {
    color: #f85149;
}

.warning {
    color: #d29922;
}

.info {
    color: #58a6ff;
}

.dim {
    color: #8b949e;
}

.bold {
    text-style: bold;
}

/* Button styling */
Button {
    background: #21262d;
    border: solid #30363d;
    color: #c9d1d9;
}

Button:hover {
    background: #30363d;
    border: solid #58a6ff;
}

Button.primary {
    background: #238636;
    border: solid #2ea043;
    color: #ffffff;
}

Button.primary:hover {
    background: #2ea043;
}

/* Select styling */
Select {
    margin: 1 0;
}

Select:focus {
    border: solid #58a6ff;
}

/* Input styling */
Input {
    border: solid #30363d;
}

Input:focus {
    border: solid #58a6ff;
}

/* Label styling */
Label {
    padding: 0;
}

/* ================================================================== */
/* Dialog Overlay Styles                                              */
/* ================================================================== */

/* Shared modal dialog backdrop */
ModalScreen {
    background: $surface 60%;
}

/* Model selector dialog */
ModelSelectorDialog > #dialog {
    border: thick $accent;
    background: $surface;
    width: 42;
    padding: 0 1;
}

ModelSelectorDialog #title {
    text-style: bold;
    padding: 1 0;
}

ModelSelectorDialog OptionList {
    height: 1fr;
    border: none;
}

ModelSelectorDialog OptionList > .option-list--option-highlighted {
    background: $accent;
    color: $text;
    text-style: bold;
}

/* Add model dialog */
AddModelDialog > #dialog {
    border: thick $accent;
    background: $surface;
    width: 50;
    padding: 1 2;
}

AddModelDialog #title {
    text-style: bold;
}

AddModelDialog #error-label {
    color: $error;
    text-style: bold;
    margin-top: 1;
}

/* Delete model dialog */
DeleteModelDialog > #dialog {
    border: thick $accent;
    background: $surface;
    width: 48;
    padding: 1 2;
}

DeleteModelDialog #title {
    text-style: bold;
}

DeleteModelDialog #model-hint {
    margin-bottom: 1;
    color: $text-muted;
}

DeleteModelDialog OptionList {
    height: 1fr;
    border: none;
}

DeleteModelDialog OptionList > .option-list--option-highlighted {
    background: $accent;
    color: $text;
    text-style: bold;
}

DeleteModelDialog #confirm-label {
    margin-bottom: 1;
}

DeleteModelDialog #confirm-warning {
    color: $text-muted;
    margin-bottom: 1;
}

DeleteModelDialog #error-label {
    color: $error;
    text-style: bold;
    margin-top: 1;
    text-align: center;
    width: 100%;
}


/* Shortcut overlay dialog */
ShortcutOverlay > #dialog {
    border: thick $secondary;
    background: $surface-darken-1;
    width: 50;
    padding: 1 2;
}

ShortcutOverlay #title {
    text-style: bold;
    width: 1fr;
    content-align: center top;
}

ShortcutOverlay #shortcuts {
    width: 1fr;
    height: auto;
}

ShortcutOverlay .shortcut-key {
    color: $accent;
    text-style: bold;
    width: 16;
}

ShortcutOverlay .shortcut-desc {
    color: $text;
}

ShortcutOverlay #hint {
    color: $text-muted;
    text-style: italic;
    width: 1fr;
    content-align: center bottom;
}
